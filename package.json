{
  "name": "sistema-financeiro",
  "version": "1.0.0",
  "description": "Sistema financeiro simples: receitas, despesas e relatórios (sem contabilidade/fiscal).",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22.9" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env src/database/seed.js",
    "test": "node --test"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  }
}
